[Unit]
Description=DealPME worker
After=network-online.target docker.service
[Service]
User=dealpme-worker
WorkingDirectory=/opt/dealpme/current/codebases/backend/worker
EnvironmentFile=/etc/dealpme/worker.env
ExecStart=/usr/bin/node dist/main.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
UMask=0077
StandardOutput=journal
StandardError=journal
[Install]
WantedBy=multi-user.target
