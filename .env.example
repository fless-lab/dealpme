# Copier en .env à la racine. Ne jamais committer de secret.
NODE_ENV=development
APP_BASE_URL=http://localhost:3000
API_PORT=4000
RPS_PORT=4100
WORKER_CONCURRENCY=4

# Trois bases séparées : marketplace (core), data room (vdr), périmètre réglementaire (rps).
# Identifiants distincts par base : une compromission en lecture de la marketplace ne doit pas donner accès à la data room (DP-OPS-042).
# L'API utilise le rôle applicatif dealpme_api (NOBYPASSRLS) : les politiques RLS s'appliquent à chaque requête.
DATABASE_URL_CORE=postgres://dealpme_api:dealpme_api@localhost:5432/dealpme_core
# Le rôle propriétaire ne sert qu'aux migrations et au chargement du jeu de démonstration.
DATABASE_URL_CORE_ADMIN=postgres://dealpme_core:dealpme_core@localhost:5432/dealpme_core
DATABASE_URL_VDR=postgres://dealpme_vdr:dealpme_vdr@localhost:5433/dealpme_vdr
DATABASE_URL_RPS=postgres://dealpme_rps:dealpme_rps@localhost:5434/dealpme_rps

REDIS_URL=redis://localhost:6379

# Stockage objet compatible S3 (MinIO en local). Aucun accès public au niveau du compte.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=dealpme
S3_SECRET_KEY=dealpme-secret
S3_BUCKET_VDR=dealpme-vdr
S3_BUCKET_IDENTITY=dealpme-identity
S3_BUCKET_DOSSIER=dealpme-dossier

# Sessions et chiffrement applicatif (générer des valeurs aléatoires en production)
# 16 caractères minimum, sinon l'API refuse de démarrer. Générer avec : openssl rand -base64 32
SESSION_SECRET=changez-moi-avant-tout-demarrage
FIELD_ENCRYPTION_KEY=changez-moi-avant-tout-demarrage
# Identifiant de la clé courante (préfixe des valeurs chiffrées) ; pour une rotation, renseigner aussi FIELD_ENCRYPTION_KEY_PREVIOUS et _PREVIOUS_ID
FIELD_ENCRYPTION_KEY_ID=v1

# Notifications : boîtes locales ; les autres intégrations restent factices tant qu'elles ne sont pas qualifiées.
# Ancien CONNECTOR_REGISTRY_MODE accepté seulement comme repli ; conflit avec le flag refusé.
CFE_API_ENABLED=false
CONNECTOR_REGISTRY_PROVIDER=mock
CFE_API_BASE_URL=http://127.0.0.1:8027
CFE_API_TIMEOUT_MS=3000
# Worker : rôle dédié créé NOLOGIN par migration ; fournir un secret lors du provisioning.
# DATABASE_URL_WORKER=postgres://dealpme_worker:SECRET@127.0.0.1:5432/dealpme_core
# Antivirus des pièces déposées. clamav est obligatoire en production, et disponible en local
# (service clamav du docker-compose, port 3310). fake ne reconnaît que la chaîne de test EICAR.
CONNECTOR_ANTIVIRUS_MODE=clamav
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
CONNECTOR_SMS_PROVIDER=local
CONNECTOR_EMAIL_PROVIDER=mailpit
# SMTP réel en local via Mailpit. En production : smtp + TLS + authentification.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_REQUIRE_TLS=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=notifications@demo.dealpme.local
MAILPIT_API_URL=http://127.0.0.1:8025
# Passerelle locale simulée ; même contrat JSON que generic-http, à qualifier chez le fournisseur.
SMS_LOCAL_BASE_URL=http://127.0.0.1:8026
SMS_LOCAL_API_KEY=dealpme-local-sms
SMS_HTTP_BASE_URL=
SMS_HTTP_API_KEY=
NOTIFICATION_TIMEOUT_MS=5000
NOTIFICATION_ATTEMPT_TIMEOUT_MS=1500
NOTIFICATION_MAX_ATTEMPTS=3
NOTIFICATION_RETRY_DELAY_MS=100
CONNECTOR_MOBILE_MONEY_PROVIDER=fake  # cinetpay | hub2 | paydunya | fake
CONNECTOR_ESIGN_PROVIDER=fake
CONNECTOR_ARCHIVING_PROVIDER=fake
CONNECTOR_REMO_API_KEY=
# local : simulateur ; remo : adaptateur du Swagger public ; disabled : aucun transport.
CONNECTOR_REMO_PROVIDER=local
REMO_LOCAL_BASE_URL=http://127.0.0.1:8028
REMO_LOCAL_API_KEY=dealpme-local-events
REMO_TIMEOUT_MS=3000
REMO_ACCOUNT_KEY=local-shared
# Quota de simulation, pas une limite contractuelle Remo.
REMO_MAX_CONCURRENT=2
REMO_MARGIN_MINUTES=10
REMO_ACCOUNT_BRAND_LABEL=DealPME
REMO_ACCOUNT_BRAND_ACCENT="#1C2751"
REMO_ACCOUNT_BRAND_WELCOME=Bienvenue à cette rencontre
REMO_ACCOUNT_BRAND_VERSION=local-v1
# Remo réel : App Token ci-dessus, compte distinct, Company ID et quota de l'offre reçue.
REMO_API_BASE_URL=https://api.virtual.events.com/api/v1
REMO_EVENT_BASE_URL=https://virtual.events.com
# REMO_COMPANY_ID=ID_MONGODB_24_CARACTERES
# REMO_QUOTA_REFERENCE=Référence du quota confirmé
# REMO_HOST_EMAIL=organisateur@example.org
REMO_FLOOR_TEMPLATE=PHOTOREALISTIC-PHOTO-REALISTIC
REMO_FLOOR_THEME=REALISTIC
# SAML : clés hors dépôt, paramètres SP recopiés du compte ; le certificat public est exportable.
REMO_SSO_ENABLED=false
# REMO_SAML_IDP_ENTITY_ID=https://dealpme.example.org/sso/remo/metadata
# REMO_SAML_SSO_URL=https://dealpme.example.org/sso/remo
# REMO_SAML_SP_ENTITY_ID=http://live.remo.co/
# REMO_SAML_ACS_URL=https://live.remo.co/__/auth/handler
# REMO_SAML_KEY_FILE=/etc/dealpme/saml/signing-key.pem
# REMO_SAML_CERT_FILE=/etc/dealpme/saml/signing-cert.pem
# REMO_SAML_PREVIOUS_CERT_FILE=/etc/dealpme/saml/previous-cert.pem
# Secret HMAC des webhooks Remo (16 caractères minimum) ; absent = webhooks refusés
CONNECTOR_REMO_WEBHOOK_SECRET=changez-moi-secret-webhook-remo
CONNECTOR_TAX_PARTNER_PROVIDER=fake
CONNECTOR_AI_PROVIDER=none

# Drapeaux fonctionnels gouvernés par un avis juridique écrit (DP-RPS-021) : rester à false tant que l'avis n'est pas archivé
FEATURE_TRANSACTION_FEES=false
FEATURE_LICENSED_PARTNER_HANDOFF=false
FEATURE_BIOMETRIC_KYC=false
FEATURE_SHARE_DEAL_LISTING=false      # V1 : démonstration maquettée uniquement
FEATURE_DEALLENS=false

# Pilote : plafond de cercle RPS par défaut (DP-RPS)
RPS_DEFAULT_CIRCLE_CAP=50
