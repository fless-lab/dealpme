{
  "name": "@dealpme/worker",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "description": "Jobs asynchrones DealPME : matching par règles, notifications (SMS/email avec consentement), ingestion documentaire (antivirus, OCR, rendu de pages), traitement idempotent des webhooks.",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@dealpme/domain": "*",
    "@dealpme/rules": "*",
    "@dealpme/connector-sms": "*",
    "@dealpme/connector-email": "*",
    "@dealpme/connector-storage": "*",
    "bullmq": "^5.58.0",
    "ioredis": "^5.7.0"
  },
  "devDependencies": {
    "@dealpme/config": "*",
    "tsx": "^4.20.5"
  }
}
