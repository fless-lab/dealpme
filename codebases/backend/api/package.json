{
  "name": "@dealpme/api",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "description": "API REST /v1 DealPME : monolithe modulaire NestJS, un module par module fonctionnel, autorisation côté serveur uniquement.",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsc -p tsconfig.json -w --preserveWatchOutput & node --env-file=../../../.env --watch dist/main.js",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=../../../.env dist/main.js",
    "db:seed": "node --env-file=../../../.env --require tsx/cjs src/seed/seed.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@dealpme/notifications": "*",
    "@dealpme/connector-antivirus": "*",
    "@dealpme/connector-email": "*",
    "@dealpme/connector-registry": "*",
    "@dealpme/connector-remo": "*",
    "@dealpme/connector-sms": "*",
    "@dealpme/connector-storage": "*",
    "@dealpme/contracts": "*",
    "@dealpme/domain": "*",
    "@dealpme/i18n": "*",
    "@dealpme/rules": "*",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "argon2": "^0.44.0",
    "drizzle-orm": "^0.45.2",
    "express": "^5.1.0",
    "ioredis": "^5.7.0",
    "postgres": "^3.4.7",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@dealpme/config": "*",
    "@dealpme/testing": "*",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.2.0",
    "drizzle-kit": "^0.31.4",
    "tsx": "^4.20.5"
  }
}
