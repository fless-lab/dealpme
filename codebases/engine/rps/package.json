{
  "name": "@dealpme/rps",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "description": "Regulatory Perimeter Service : service indépendant avec sa propre base. Paliers T0/T1/T2, compteur de divulgation par personne, plafond de cercle, filtre de communication, journal réglementaire haché append-only, pack de preuves.",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@dealpme/contracts": "*",
    "@dealpme/domain": "*",
    "@dealpme/rules": "*",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "drizzle-orm": "^0.44.5",
    "postgres": "^3.4.7",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@dealpme/config": "*",
    "@types/express": "^5.0.3",
    "drizzle-kit": "^0.31.4",
    "tsx": "^4.20.5"
  }
}
